RAG_PROFILE=lite
RAG_DATA_DIR=.local-data
RAG_ARTIFACTS_DIR=.local-artifacts
RAG_OBJECT_STORE=local
RAG_DATABASE_URL=sqlite:///.local-data/enterprise_rag.sqlite3

# Optional Docker lite bind mounts (host-side; keep on a drive with free space).
RAG_DOCKER_DATA_DIR=./.local-data
RAG_DOCKER_ARTIFACTS_DIR=./.local-artifacts
RAG_API_PORT=8000

# Optional local answer model. Enable only for a trusted local Ollama server.
# Local Python API: http://127.0.0.1:11434; Docker API: host.docker.internal
RAG_LLM_PROVIDER=none
RAG_LLM_MODEL=qwen2.5:3b
RAG_LLM_BASE_URL=http://host.docker.internal:11434
RAG_LLM_TIMEOUT_SECONDS=90
RAG_VISUAL_TIMEOUT_SECONDS=180

# Optional local API demo auth; leave empty until a DB user is provisioned.
RAG_API_TOKEN=
RAG_DEMO_TENANT_ID=
RAG_DEMO_USER_ID=
